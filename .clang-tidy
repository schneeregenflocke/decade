---
Checks:
  - -*
  - clang-diagnostic-*
  - clang-analyzer-*
  - bugprone-*
  # Flags two same-typed parameters as "swappable"; high false-positive rate on
  # semantically distinct arguments (e.g. width/height, x/y) — not actionable.
  - -bugprone-easily-swappable-parameters
  - cert-*
  - concurrency-*
  - cppcoreguidelines-*
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  # glm vectors expose components via a union (.x/.y/.z); using glm at all trips
  # this. The only "fix" is [] indexing, which hurts readability.
  - -cppcoreguidelines-pro-type-union-access
  # reinterpret_cast and raw pointer/array handling are required for the
  # OpenGL, fontconfig and FreeType C APIs (buffer offsets, glGetIntegerv
  # out-params, FcChar8 strings). Unavoidable at the infrastructure boundary.
  - -cppcoreguidelines-pro-type-reinterpret-cast
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  # The codebase deliberately holds const and reference members (e.g. EventBus
  # references, immutable config); they make the owning type non-assignable on
  # purpose. Enforcing this would force redesigns against that intent.
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  # Downcasts happen in exactly two shapes here, and both settle the type
  # first: after Drawable::Kind() has named it, or through a ShapeNode handle
  # that built the shape itself (#68). A dynamic_cast would ask the RTTI again
  # for what is already known. The check cannot see the handle case either —
  # ShapeT is a dependent template parameter — so leaving it on would enforce
  # half the rule and read as protection the code does not have.
  - -cppcoreguidelines-pro-type-static-cast-downcast
  - google-*
  # Qt and Boost APIs use plain long/short directly; fixed-width substitutes
  # would fight those library signatures.
  - -google-runtime-int
  - hicpp-*
  # Same C-array-to-GL-C-API decay as the cppcoreguidelines variant above.
  - -hicpp-no-array-decay
  - llvm-*
  - -llvm-header-guard
  # Contradicts misc-use-anonymous-namespace, which is on: one demands static
  # for a translation-unit-local function, the other the anonymous namespace.
  # Google style (in force here) uses the anonymous namespace, so this one goes.
  - -llvm-prefer-static-over-anonymous-namespace
  - misc-*
  - modernize-*
  - -modernize-use-trailing-return-type
  - performance-*
  - portability-*
  - readability-*
  # Short names (i, x, ar, dc, ft) are idiomatic in loop/lambda/GL/Qt contexts;
  # enforcing a minimum length hurts more than it helps here.
  - -readability-identifier-length
WarningsAsErrors: ""
HeaderFileExtensions:
  - ""
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
# Analyse the project's own headers as well, not the translation units alone —
# a declaration carries the naming rules and the include discipline just as much
# as its definition does.
# external/ submodules are excluded here; system headers via SystemHeaders.
HeaderFilterRegex: ".*/(src|tests)/.*"
ExcludeHeaderFilterRegex: ".*/external/.*"
FormatStyle: file
User: schneeregenflocke
SystemHeaders: false
# Enforce the Google C++ Style member convention (decided naming target): class
# data members are snake_case with a trailing underscore. Only the member
# categories are configured, so readability-identifier-naming leaves functions,
# types and locals alone (those are not part of the enforced rule). struct
# members are public and intentionally carry no suffix.
CheckOptions:
  # Three C libraries document one entry point and put their symbols in
  # headers behind it: libepoxy (<epoxy/gl.h>, which refuses to compile after
  # GL/gl.h), libpng (<png.h>) and FreeType (<ft2build.h> plus the
  # FT_FREETYPE_H macro, whose internal paths are not portable). Without this
  # the check demands those headers in every unit that calls them.
  misc-include-cleaner.IgnoreHeaders: "epoxy/.*;pngconf.h;freetype/.*"
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: "_"
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: "_"
---
